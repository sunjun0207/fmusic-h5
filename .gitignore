# 环境变量:.env.local / .env.dev / .env.pro 为团队共享配置,需要提交;
# 仅忽略个人覆盖文件(如 .env.dev.local)
.env
.env.*.local

# Docker TLS 证书(fullchain.pem / privkey.pem 放 docker/{local,dev,pro}/ssl/,勿提交;local 为自签)
docker/*/ssl/*.pem
docker/*/ssl/*.key
docker/*/ssl/*.crt
# certbot webroot
docker/*/certbot-www
