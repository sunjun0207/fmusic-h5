# ===== 本地开发环境(默认 mode,不传 --mode)=====
# 使用方式:npm run dev
# 注意:Vite 禁止使用 "local" 作为 mode 名称,因此本地环境直接使用默认 mode;
#      Vite 会在所有 mode 下加载 .env.local 作为基础配置,
#      再由 .env.dev / .env.pro 按 mode 覆盖同名变量。

# 环境标识(可在代码中通过 import.meta.env.VITE_APP_ENV 读取)
VITE_APP_ENV=local
# 页面标题(index.html 中通过 %VITE_APP_TITLE% 引用)
VITE_APP_TITLE=聆听xuejun.yan · 本地

# 部署基础路径(对应 vite 的 base)
VITE_BASE=/
# 是否生成 sourcemap
VITE_SOURCEMAP=true
# 开发服务器端口
VITE_DEV_PORT=5173

# 以下 *_TARGET 同时被两处使用:
#   - vite.config.ts 开发服务器代理(pnpm run dev)
#   - Docker 镜像内 nginx 反代模板(docker-compose.*.yml 通过 env_file 注入)
# 自有 API 后端(/proxy/api/* 的目标)
VITE_API_TARGET=https://music.4848948.xyz

# 酷我各服务
VITE_KW_SEARCH_TARGET=http://search.kuwo.cn
VITE_KW_OPENAPI_TARGET=https://kuwo.cn
VITE_KW_NMOBI_TARGET=https://nmobi.kuwo.cn
VITE_KW_IMG_TARGET=https://img1.kuwo.cn
VITE_KW_CDN_TARGET=http://kw-er.kuwo.cn
